# PostgreSQL used by the Spring Boot backend
POSTGRES_DB=smartlib
POSTGRES_USER=smartlib
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_URL=jdbc:postgresql://db:5432/smartlib
DB_USERNAME=smartlib
DB_PASSWORD=replace-with-a-long-random-password

# Bootstrap runs only when all four values are supplied. Use unique values;
# the application has no built-in admin username or password.
SMARTLIB_BOOTSTRAP_ADMIN_USERNAME=choose-a-unique-admin-name
SMARTLIB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
SMARTLIB_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
SMARTLIB_BOOTSTRAP_ADMIN_FULL_NAME=SmartLib Administrator

# Set true when TLS terminates before the application and HTTPS is guaranteed.
SESSION_COOKIE_SECURE=false
