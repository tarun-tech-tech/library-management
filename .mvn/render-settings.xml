<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <mirrors>
        <!-- Render's shared build IP is rate-limited on public Central endpoints.
             Aliyun's HTTPS public mirror keeps the same Maven coordinates while
             avoiding that shared-IP limit for this academic deployment. -->
        <mirror>
            <id>central-aliyun</id>
            <name>Maven Central via Aliyun public mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>
</settings>
